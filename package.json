{
	"name": "obsidian-linear",
	"version": "1.1.2",
	"description": "Integrate Linear issues with advanced filtering, sorting, and visual enhancements in Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"linear",
		"project-management",
		"task-management",
		"issue-tracking"
	],
	"author": "Casey Becking",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/caseybecking/obsidian-linear-plugin"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@linear/sdk": "^40.0.0"
	}
}
